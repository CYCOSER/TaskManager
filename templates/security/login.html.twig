{% extends 'base.html.twig' %}

{% block title %}Вход в систему{% endblock %}

{% block body %}
    {# Внешний контейнер: flex + pt-24 задает положение верхней точки карточки #}
    <div class="min-h-screen bg-[#111827] flex justify-center pt-24 px-4 box-border">

        {# Карточка: h-fit не дает ей растягиваться по вертикали #}
        <div class="bg-gray-800 border border-gray-700 w-full max-w-[400px] h-fit p-8 rounded-2xl shadow-2xl flex flex-col">

            <h2 class="text-2xl font-bold text-white mb-6 text-center tracking-wide">Авторизация</h2>

            <form method="post" autocomplete="off" class="space-y-5 m-0">

                {# Блок ошибок авторизации Symfony #}
                {% if error %}
                    <div class="p-3 bg-red-500/10 border border-red-500/30 rounded-sm text-red-400 text-xs tracking-wide">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                {# Поле: Email #}
                <div class="flex flex-col">
                    <label for="inputEmail" class="block text-sm font-sm text-gray-400 mb-1">Email</label>
                    <input type="email"
                           value="{{ last_username }}"
                           name="email" {# Имя поля возвращено к исходному рабочему варианту #}
                           id="inputEmail"
                           class="w-full bg-gray-900/70 border border-gray-700 rounded-sm text-white text-sm px-4 py-3 focus:ring-2 focus:ring-indigo-500 outline-none transition"
                           placeholder="your@email.com"
                           required
                           autofocus
                           autocomplete="email">
                </div>

                {# Пароль #}
                <div class="flex flex-col">
                    <label for="inputPassword" class="block text-sm font-sm text-gray-400 mb-1">Пароль</label>
                    <input type="password"
                           name="password" {# Имя поля возвращено к исходному рабочему варианту #}
                           id="inputPassword"
                           class="w-full bg-gray-900/70 border border-gray-700 rounded-sm text-white text-sm px-4 py-3 focus:ring-2 focus:ring-indigo-500 outline-none transition"
                           placeholder="••••••••••••"
                           required
                           autocomplete="current-password">
                </div>

                {# CSRF Токен безопасности с твоим оригинальным дата-контроллером #}
                <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

                {# Блок кнопки #}
                <div class="pt-2">
                    <button type="submit"
                            class="w-full bg-indigo-600 text-white text-sm tracking-[0.15em] uppercase py-3 rounded-sm hover:bg-indigo-700 transition cursor-pointer font-medium shadow-lg shadow-indigo-600/20">
                        Войти
                    </button>
                </div>

                {# Ссылка на регистрацию #}
                <div class="text-center pt-2">
                    <p class="text-xs text-gray-400">
                        Ещё нет аккаунта?
                        <a href="{{ path('app_register') }}" class="text-indigo-400 hover:text-indigo-300 transition ml-1 font-medium">
                            Зарегистрироваться
                        </a>
                    </p>
                </div>
            </form>

        </div>
    </div>
{% endblock %}
